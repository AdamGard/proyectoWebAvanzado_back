  "components": {
    "schemas": {
      "ActividadCreateDto": {
        "required": [
          "fecha",
          "nivel",
          "nombre",
          "tipo"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "tipo": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "nivel": {
            "minLength": 1,
            "pattern": "^(Inicial|Basico|Intermedio|Avanzado)$",
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "responsableUsuarioId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
